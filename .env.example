DISCORD_TOKEN=your_bot_token_here

# Optional: enables Spotify search + link support
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional: path to a cookies.txt file for yt-dlp (age-restricted videos, etc.)
YTDLP_COOKIES_FILE=

# Optional: path to the SQLite database file (default: ./data/turnpike.db)
DATABASE_PATH=

# Optional (Docker only): yt-dlp release/channel to use instead of the latest
# stable, e.g. 2025.01.15 or nightly
YTDLP_VERSION=
